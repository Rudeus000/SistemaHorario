def generar_horario_inteligente(profesores, aulas, cursos):
    # Estructuras de control
    horario = {dia: {bloque: None for bloque in BLOQUES} for dia in DIAS}
    asignaciones_profesor = defaultdict(set)
    asignaciones_aula = defaultdict(set)

    # Ordenar cursos por complejidad (horas semanales)
    cursos.sort(key=lambda x: x['horas_semanales'], reverse=True)

    for curso in cursos:
        horas_asignadas = 0
        profesor = profesores[curso['profesor_id']]
        aula = aulas[curso['aula_id']]

        while horas_asignadas < curso['horas_semanales']:
            asignado = False

            # Buscar bloque disponible con prioridad en días no completos
            dias_disponibles = list(profesor['disponibilidad'].keys())
            random.shuffle(dias_disponibles)  # Aleatorizar el orden de los días

            for dia in dias_disponibles:
                bloques_disponibles = list(set(profesor['disponibilidad'][dia]) - asignaciones_profesor[(curso['profesor_id'], dia)])
                random.shuffle(bloques_disponibles)  # Aleatorizar el orden de los bloques

                for bloque in bloques_disponibles:
                    if (bloque not in asignaciones_profesor[(curso['profesor_id'], dia)] and
                        bloque not in asignaciones_aula[(curso['aula_id'], dia)]):

                        # Verificar límite diario de 9 horas (12 bloques)
                        if len(asignaciones_profesor[(curso['profesor_id'], dia)]) < 12:
                            # Verificar capacidad del aula
                            if aula['capacidad'] >= curso['alumnos']:
                                # Asignar bloque
                                horario[dia][bloque] = {
                                    'curso': curso['nombre'],
                                    'profesor': profesor['nombre'],
                                    'aula': f"Aula {curso['aula_id']} ({aula['tipo']})"
                                }
                                asignaciones_profesor[(curso['profesor_id'], dia)].add(bloque)
                                asignaciones_aula[(curso['aula_id'], dia)].add(bloque)
                                horas_asignadas += 0.75
                                asignado = True
                                break
                    if asignado:
                        break
                if asignado:
                    break
            if not asignado:
                # Implementar backtracking si no se puede asignar
                raise ValueError(f"No se puede asignar el curso: {curso['nombre']}")

    return horario

def imprimir_horario(horario, indice):
    print(f"\nHorario {indice+1}:")
    for dia in DIAS:
        print(f"\n{dia.upper()}")
        print("Hora      | Curso        | Profesor      | Aula")
        print("--------------------------------------------------")
        for bloque in BLOQUES:
            detalle = horario[dia][bloque]
            if detalle:
                hora_inicio = 7 + (bloque-1)*0.75
                hora_str = f"{int(hora_inicio):02d}:{int((hora_inicio%1)*60):02d}"
                print(f"{hora_str}-{(hora_inicio+0.75):.2f} | {detalle['curso'][:10]:<10} | {detalle['profesor'][:10]:<10} | {detalle['aula']}")

